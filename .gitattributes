# Normalize all text files to LF in the repo and in the working tree,
# on every OS (Windows, macOS, Linux). Matches Prettier's "endOfLine": "lf".
* text=auto eol=lf

# Source & config
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.prisma   text eol=lf
*.sql      text eol=lf
*.env*     text eol=lf
*.sh       text eol=lf
.editorconfig  text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
.prettierrc    text eol=lf

# Windows-only scripts must keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Lockfile: treat as generated (no noisy diffs, no merge attempts)
package-lock.json  text eol=lf linguist-generated=true -diff merge=binary

# Binary files: never touch line endings or diff them
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.zip   binary
